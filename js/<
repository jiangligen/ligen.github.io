    <script>
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() { document.body.classList.remove('is-preload'); }, 1500);

        var lazyImgs = document.querySelectorAll('img[data-src]');
        if ('IntersectionObserver' in window) {
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        var img = entry.target;
                        if (img.dataset.src) {
                            var realSrc = img.dataset.src;
                            img.removeAttribute('data-src');
                            
                            var tempImg = new Image();
                            tempImg.onload = function() {
                                img.src = realSrc;
                                img.classList.remove('is-loading');
                            };
                            tempImg.src = realSrc;
                        }
                        observer.unobserve(img);
                    }
                });
            }, { 
                rootMargin: '300px 0px', 
                threshold: 0.01 
            });
            
            for (var i = 0, len = lazyImgs.length; i < len; i++) {
                observer.observe(lazyImgs[i]);
            }
        } else {
            for (var i = 0, len = lazyImgs.length; i < len; i++) {
                lazyImgs[i].src = lazyImgs[i].dataset.src;
                lazyImgs[i].removeAttribute('data-src');
                lazyImgs[i].classList.remove('is-loading');
            }
        }

        var emailLink = document.getElementById('contact-link');
        if (emailLink) {
            emailLink.addEventListener('mouseenter', function() {
                var emailSpan = document.getElementById('email-text');
                if (!emailSpan) return;

                var rawText = emailSpan.textContent.trim();
                var cleanEmail = rawText.replace(/\s*[\(\[\{#]?at[\)\]\}#]?\s*/gi, '@');

                this.href = 'mailto:' + cleanEmail;
                emailSpan.textContent = cleanEmail;
            }, {once: true});
        }

        var contactForm = document.querySelector('#footer form');
        if (contactForm) {
            contactForm.addEventListener('submit', function(e) {
                e.preventDefault();
                e.stopPropagation();

                var submitBtn = contactForm.querySelector('input[type="submit"]');
                var originalVal = submitBtn ? submitBtn.value : 'SEND';
                var formAction = contactForm.getAttribute('action');

                if (!formAction || formAction === '#' || formAction.trim() === '') {
                    alert('请先配置接收邮件的接口链接！');
                    return false;
                }

                if (submitBtn) {
                    submitBtn.value = 'SENDING...';
                    submitBtn.disabled = true;
                }

                var formData = new FormData(contactForm);

                fetch(formAction, {
                    method: 'POST',
                    body: formData,
                    headers: { 'Accept': 'application/json' }
                })
                .then(function(response) {
                    if (response.ok) {
                        alert('留言已成功发送，感谢您的联系！');
                        contactForm.reset();
                    } else {
                        alert('发送失败，请稍后再试或通过邮箱联系：me@ligen.net');
                    }
                })
                .catch(function(error) {
                    alert('网络连接错误，无法完成发送。');
                })
                .finally(function() {
                    if (submitBtn) {
                        submitBtn.value = originalVal;
                        submitBtn.disabled = false;
                    }
                });

                return false;
            });
        }
    });
    </script>

