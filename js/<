function processCdnImage($url, $cdnType, $rawDomain, $cdnDomain, $params) {
    if (!$url || $cdnType === 'off' || empty($params)) {
        return $url;
    }

    if (strpos($url, $rawDomain) !== false) {
        $url = str_replace($rawDomain, $cdnDomain, $url);
    }

    switch ($cdnType) {
        case 'cf':
            return str_replace($cdnDomain . "/", $cdnDomain . "/cdn-cgi/image/{$params}/", $url);
        
        case 'aliyun':
            $connector = (strpos($url, '?') !== false) ? '&' : '?';
            return $url . $connector . 'x-oss-process=' . ltrim($params, '?');

        case 'tencent':
        case 'qiniu':
            $connector = (strpos($url, '?') !== false) ? '&' : '?';
            return $url . $connector . ltrim($params, '?');

        default:
            return $url;
    }
}

